# PostgreSQL / Supabase / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Protect the manual/Vercel Cron refresh endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret

# Public canonical domain, no trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional source overrides
FIPIRAN_BASE_URL=https://www.fipiran.com/services
TSETMC_BASE_URL=https://cdn.tsetmc.com/api

# If TSETMC is blocked from your region, keep true; refresh will continue using Fipiran data.
ALLOW_SOURCE_DEGRADATION=true

# When TSETMC client-type bulk data is blocked, enrich the most-traded ETFs from Fipiran.
FIPIRAN_CLIENT_FALLBACK_LIMIT=100

# Local development only. Shows clearly-labeled demo data when DB is empty.
DEMO_MODE=false
